---
---

<section id="cta" class="py-24 sm:py-32">
  <div class="container-wide">
    <div
      class="relative overflow-hidden rounded-3xl bg-brand-700 px-8 py-16 text-center shadow-2xl shadow-brand-900/20 sm:px-16 sm:py-20"
    >
      <!-- Decorative pattern -->
      <div
        aria-hidden="true"
        class="absolute inset-0 opacity-20 [mask-image:radial-gradient(60%_60%_at_50%_50%,black,transparent)]"
      >
        <div class="bg-grid-dark absolute inset-0"></div>
      </div>
      <div
        aria-hidden="true"
        class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-white/20 blur-3xl"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-accent-500/15 blur-3xl"
      >
      </div>

      <div class="relative">
        <h2
          class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
        >
          准备好加速你的产品发布了吗？
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-white/90">
          14 天免费试用，零风险。所有核心功能立即可用，无需信用卡。
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="#"
            class="inline-flex h-12 w-full items-center justify-center rounded-xl bg-white px-6 text-base font-medium text-slate-900 shadow-sm transition hover:bg-slate-100 sm:w-auto"
          >
            免费开始
            <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="#"
            class="inline-flex h-12 w-full items-center justify-center rounded-xl border border-white/30 bg-white/10 px-6 text-base font-medium text-white backdrop-blur transition hover:bg-white/20 sm:w-auto"
          >
            联系销售
          </a>
        </div>
      </div>
    </div>
  </div>
</section>