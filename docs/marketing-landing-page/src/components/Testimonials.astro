---
const testimonials = [
  {
    quote:
      "我们用了 Lumen 之后，把产品发布周期从三周缩短到了三天。团队节奏和沟通效率都发生了质的变化。",
    name: "陈晓",
    role: "CTO @ Hooli",
    avatar: "陈",
  },
  {
    quote:
      "AI 助手帮我处理了大量重复代码。现在我能把更多时间花在真正困难的架构决策上，而不是被体力活拖住。",
    name: "Maria Chen",
    role: "Staff Engineer @ Globex",
    avatar: "M",
  },
  {
    quote:
      "Lumen 的可观测性让我们第一次真正看清了产品全貌。问题能被更快发现，但更重要的是机会也更容易被看到。",
    name: "Daniel Park",
    role: "VP Product @ Initech",
    avatar: "D",
  },
];
---

<section class="py-24 sm:py-32">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <p
        class="text-sm font-semibold tracking-wider text-brand-600 uppercase dark:text-brand-400"
      >
        客户证言
      </p>
      <h2
        class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
      >
        受到全球产品团队的喜爱
      </h2>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-3">
      {
        testimonials.map((t) => (
          <figure
            class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:shadow-lg hover:shadow-slate-900/5 dark:border-slate-800 dark:bg-slate-900 dark:hover:shadow-black/30"
          >
            <svg
              class="h-8 w-8 text-brand-400"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M9.27 17.5c1.18 0 2.21-.42 3.07-1.27.86-.85 1.29-1.88 1.29-3.09 0-1.21-.43-2.24-1.29-3.09-.86-.85-1.89-1.27-3.07-1.27-.18 0-.36.01-.54.04.18-1.18.67-2.21 1.46-3.09.79-.88 1.74-1.49 2.86-1.83l-.5-1.7c-1.5.46-2.79 1.29-3.88 2.5-1.09 1.21-1.77 2.6-2.04 4.16-.18 1.05-.27 2.34-.27 3.88 0 1.5.43 2.71 1.29 3.62.86.91 1.89 1.36 3.07 1.36zm9 0c1.18 0 2.21-.42 3.07-1.27.86-.85 1.29-1.88 1.29-3.09 0-1.21-.43-2.24-1.29-3.09-.86-.85-1.89-1.27-3.07-1.27-.18 0-.36.01-.54.04.18-1.18.67-2.21 1.46-3.09.79-.88 1.74-1.49 2.86-1.83l-.5-1.7c-1.5.46-2.79 1.29-3.88 2.5-1.09 1.21-1.77 2.6-2.04 4.16-.18 1.05-.27 2.34-.27 3.88 0 1.5.43 2.71 1.29 3.62.86.91 1.89 1.36 3.07 1.36z" />
            </svg>
            <blockquote class="mt-4 text-base leading-relaxed text-slate-700 dark:text-slate-300">
              "{t.quote}"
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span
                class="grid h-10 w-10 place-items-center rounded-full bg-ink text-sm font-semibold text-white"
              >
                {t.avatar}
              </span>
              <div>
                <div class="text-sm font-semibold text-slate-900 dark:text-white">
                  {t.name}
                </div>
                <div class="text-xs text-slate-500 dark:text-slate-400">
                  {t.role}
                </div>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>