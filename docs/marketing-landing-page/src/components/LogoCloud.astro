---
const logos = [
  "Acme Co",
  "Globex",
  "Initech",
  "Hooli",
  "Massive",
  "Pied Piper",
];
---

<section class="border-y border-slate-200/60 py-12 dark:border-slate-800/60">
  <div class="container-wide">
    <p
      class="text-center text-sm font-medium text-slate-500 dark:text-slate-400"
    >
      全球数千支团队信赖 Lumen
    </p>
    <div
      class="mt-8 grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3 lg:grid-cols-6"
    >
      {
        logos.map((name) => (
          <div class="flex items-center justify-center">
            <span
              class="text-lg font-semibold tracking-tight text-slate-400 transition hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300"
            >
              {name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
