---
const cols = [
  {
    title: "产品",
    links: ["功能", "价格", "更新日志", "路线图"],
  },
  {
    title: "资源",
    links: ["文档", "指南", "博客", "社区"],
  },
  {
    title: "公司",
    links: ["关于我们", "招聘", "媒体", "联系我们"],
  },
  {
    title: "法律",
    links: ["隐私", "条款", "安全", "合规"],
  },
];

const socials = [
  { label: "GitHub", path: "M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z" },
  { label: "Twitter", path: "M23 3a10.9 10.9 0 0 1-3.14 1.53A4.48 4.48 0 0 0 12 7v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" },
  { label: "LinkedIn", path: "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" },
];
---

<footer class="border-t border-slate-200 py-16 dark:border-slate-800">
  <div class="container-wide">
    <div class="grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a
          href="/"
          class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-900 dark:text-white"
        >
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-ink text-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" />
            </svg>
          </span>
          Lumen
        </a>
        <p class="mt-4 max-w-sm text-sm text-slate-600 dark:text-slate-400">
          为高产能团队打造的现代工作流平台。让每一次发布都比上一次更快。
        </p>

        <div class="mt-6 flex items-center gap-3">
          {
            socials.map((s) => (
              <a
                href="#"
                aria-label={s.label}
                class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 bg-white text-slate-500 transition hover:border-slate-300 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:border-slate-700 dark:hover:text-white"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={s.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:col-span-3">
        {
          cols.map((c) => (
            <div>
              <h4 class="text-sm font-semibold text-slate-900 dark:text-white">
                {c.title}
              </h4>
              <ul class="mt-4 space-y-3">
                {c.links.map((l) => (
                  <li>
                    <a
                      href="#"
                      class="text-sm text-slate-600 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
                    >
                      {l}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-slate-200 pt-8 text-sm text-slate-500 sm:flex-row sm:items-center dark:border-slate-800 dark:text-slate-400"
    >
      <p>© 2026 Lumen, Inc. 保留所有权利。</p>
      <p class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        所有系统运行正常
      </p>
    </div>
  </div>
</footer>