---
---

<section id="showcase" class="py-24 sm:py-32">
  <div class="container-wide">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <!-- Copy -->
      <div>
        <p
          class="text-sm font-semibold tracking-wider text-brand-600 uppercase dark:text-brand-400"
        >
          产品
        </p>
        <h2
          class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
        >
          一行命令，构建生产级应用
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
          使用熟悉的工具链，让 Lumen 在几秒钟内完成脚手架、类型检查、依赖安装与本地启动。剩下的时间，专注在你的业务逻辑上。
        </p>

        <ul class="mt-8 space-y-4">
          {
            [
              "零配置 TypeScript + ESLint + Prettier",
              "内置数据库、身份认证与文件存储",
              "实时日志、热更新、即时回滚",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid h-5 w-5 flex-shrink-0 place-items-center rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-400">
                  <svg
                    class="h-3 w-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                <span class="text-base text-slate-700 dark:text-slate-300">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Terminal mock -->
      <div class="relative">
        <div
          aria-hidden="true"
          class="absolute -inset-4 rounded-3xl bg-brand-500/10 blur-2xl"
        >
        </div>
        <div
          class="relative overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 shadow-2xl shadow-slate-900/20 dark:border-slate-800"
        >
          <div
            class="flex items-center gap-2 border-b border-slate-800 bg-slate-900/80 px-4 py-3"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
            <span class="ml-3 text-xs text-slate-400">~/lumen-app</span>
          </div>
          <div class="p-5 font-mono text-sm leading-relaxed">
            <p><span class="text-brand-400">$</span> <span class="text-slate-300">lumen new my-app</span></p>
            <p class="text-slate-500">› 正在创建项目结构…</p>
            <p class="text-slate-500">› 安装依赖（84 个包）…</p>
            <p class="text-emerald-400">✓ 项目创建成功</p>
            <p class="mt-3"><span class="text-brand-400">$</span> <span class="text-slate-300">cd my-app && lumen dev</span></p>
            <p class="text-slate-500">› 启动开发服务器</p>
            <p class="text-slate-500">› 监听 <span class="text-amber-400">http://localhost:3000</span></p>
            <p class="mt-3 text-slate-500">
              <span class="inline-block h-3 w-1.5 bg-brand-400 align-middle animate-pulse"></span>
              <span class="ml-1 text-brand-300">就绪，等待输入…</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>