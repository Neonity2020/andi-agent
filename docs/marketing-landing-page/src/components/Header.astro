---
const navLinks = [
  { href: "#features", label: "功能" },
  { href: "#showcase", label: "产品" },
  { href: "#pricing", label: "价格" },
  { href: "#faq", label: "常见问题" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/60 bg-white/70 backdrop-blur-md dark:border-slate-800/60 dark:bg-slate-950/70"
>
  <div
    class="container-wide flex h-16 items-center justify-between"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-900 dark:text-white"
    >
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-ink text-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" />
        </svg>
      </span>
      Lumen
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-slate-600 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <button
        type="button"
        id="theme-toggle"
        aria-label="切换主题"
        class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <svg class="h-4 w-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="h-4 w-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <a
        href="#"
        class="hidden text-sm font-medium text-slate-600 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white sm:block"
      >
        登录
      </a>
      <a
        href="#cta"
        class="inline-flex h-9 items-center rounded-lg bg-slate-900 px-4 text-sm font-medium text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
      >
        开始使用
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    root.classList.toggle("dark");
    try {
      localStorage.setItem(
        "theme",
        root.classList.contains("dark") ? "dark" : "light"
      );
    } catch (_) {}
  });
</script>
